{
  "name": "personal-site",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "build:ci": "prettier --check . && astro check && astro build && node scripts/check-budgets.mjs",
