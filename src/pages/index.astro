---
import Base from "../layouts/Base.astro";
import { profile } from "../lib/site";
---

<Base>
  <main>
    <h1>{profile.name}</h1>
    {
      profile.provisional && (
        <p class="notice">
          This site is being rebuilt. A proper introduction is on its way.
        </p>
      )
    }
  </main>
</Base>

<style>
  /*
    Stage 1 holds no final composition, only enough to exercise the tokens.
    The measure, scale and asymmetry arrive in Stage 2. Every value here comes
    from src/styles/global.css.
  */
  main {
    max-width: var(--measure);
    padding: var(--space-7) var(--space-4) var(--space-6);
    margin-inline: 0;
    padding-inline-start: max(var(--space-4), 6vw);
  }

  h1 {
    font-size: var(--text-xl);
    font-weight: var(--weight-medium);
    line-height: var(--leading-tight);
    letter-spacing: -0.015em;
  }

  .notice {
    margin-block-start: var(--space-4);
    padding-block-start: var(--space-4);
    border-block-start: 1px solid var(--colour-rule);
    color: var(--colour-secondary);
    font-size: var(--text-lg);
    max-width: 34ch;
  }
</style>
